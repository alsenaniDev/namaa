{
  "expo": {
    "name": "نماء - إدارة الميزانية الشخصية",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleName": "نماء",
        "CFBundleDisplayName": "نماء",
        "CFBundleLocalizations": ["ar", "en"],
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "supportsRTL": true
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      "./plugins/withForceRTL"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

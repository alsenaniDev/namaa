{
  "expo": {
    "name": "نماء - إدارة الميزانية الشخصية",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpeg",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "3",
      "infoPlist": {
        "CFBundleName": "نماء",
        "CFBundleDisplayName": "نماء",
        "CFBundleLocalizations": [
          "ar",
          "en"
        ],
        "CFBundleDevelopmentRegion": "ar",
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": false
      },
      "bundleIdentifier": "com.alsenanidev.mobile"
    },
    "android": {
      "package": "com.alsenanidev.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.jpeg"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ar",
              "en"
            ],
            "android": [
              "ar",
              "en"
            ]
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "mode": "production",
          "color": "#10B981",
          "defaultChannel": "reminders"
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": false,
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "9e238281-3dd4-4399-856e-9bbb6a24a5bc"
      }
    }
  }
}
